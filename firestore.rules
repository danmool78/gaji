rules_version = '2';
// 가지 · 동아리 명부 보안 규칙
// ------------------------------------------------------------
// Firebase에는 개인정보를 최소로 둔다.
//   clubs/{주소}              : 공개 정보 (이름 · 색 · 로고) — 누구나 읽기
//   clubs/{주소}/private/info : 마스터 계정 ID 1개 + 연결 정보 + 사용 현황 숫자
//   clubs/{주소}/handover/current : 마스터 넘기기 일회용 코드 (마스터만 읽음)
//   clubs/{주소}/claims/{uid} : 넘겨받는 사람이 코드를 제출하는 칸
//   masters/{uid}             : 내가 마스터인 동아리 주소 목록 (본인만)
//   system/config             : 시스템 마스터 계정 ID 목록 (콘솔에서만 수정)
//   clubs/{주소}/support/{id} : 마스터 ↔ 시스템 문의 (그 동아리 마스터와 시스템 마스터만)
// 부원 · 관리자 이름, 이메일, 학번, 실험 내용은 여기에 없다 (각 동아리 드라이브에만).
// ------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSystem() {
      return signedIn() && exists(/databases/$(database)/documents/system/config)
        && request.auth.uid in get(/databases/$(database)/documents/system/config).data.admins;
    }
    function infoPath(slug) { return /databases/$(database)/documents/clubs/$(slug)/private/info; }
    function isMaster(slug) {
      return signedIn() && exists(infoPath(slug)) && get(infoPath(slug)).data.masterUid == request.auth.uid;
    }
    function validSlug(slug) {
      return slug.matches('^[a-z0-9][a-z0-9-]{2,29}$') && !(slug in ['demo', 'system', 'admin', 'api', 'www', 'gaji']);
    }
    function validPublic(d) {
      return d.keys().hasOnly(['name', 'color', 'color2', 'logo', 'createdAt', 'version', 'connector'])
        && (!('version' in d) || (d.version is string && d.version.size() <= 20))
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 30
        && d.color is string && d.color.matches('^#[0-9A-Fa-f]{6}$')
        && (!('color2' in d) || (d.color2 is string && d.color2.matches('^#[0-9A-Fa-f]{6}$')))
        && (!('logo' in d) || (d.logo is string && d.logo.size() <= 120000 && (d.logo == '' || d.logo.matches('^data:image/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/=]+$'))))
        && (!('connector' in d) || d.connector == '' || (d.connector is string && d.connector.size() <= 300
            && d.connector.matches('^https://script[.]google[.]com/.*')))
        && d.createdAt is timestamp;
    }
    function numOk(s, k) { return !(k in s) || (s[k] is int && s[k] >= 0 && s[k] <= 100000); }
    function strOk(s, k, n) { return !(k in s) || (s[k] is string && s[k].size() <= n); }
    function validStats(s) {
      return numOk(s, 'members') && numOk(s, 'experiments') && numOk(s, 'ideas') && numOk(s, 'done') && numOk(s, 'running') && numOk(s, 'devices') && numOk(s, 'waiting')
        && strOk(s, 'lastEdit', 10) && strOk(s, 'backupAt', 10) && strOk(s, 'core', 12) && strOk(s, 'version', 20)
        && (!('backupErr' in s) || s.backupErr is bool) && (!('lastActive' in s) || s.lastActive is timestamp);
    }
    function validInfo(d) {
      return d.keys().hasOnly(['masterUid', 'domain', 'connectorUrl', 'sheetId', 'stats', 'createdAt'])
        && d.masterUid is string
        && (!('domain' in d) || (d.domain is string && d.domain.size() <= 60))
        && (!('connectorUrl' in d) || (d.connectorUrl is string && d.connectorUrl.size() <= 300))
        && (!('sheetId' in d) || (d.sheetId is string && d.sheetId.size() <= 100))
        && (!('stats' in d) || (d.stats is map && d.stats.size() <= 16 && validStats(d.stats)));
    }

    // ---------- 동아리 공개 정보 ----------
    match /clubs/{slug} {
      allow get: if true;            // 동아리 주소를 아는 사람은 공개 정보를 봄
      allow list: if isSystem();     // 모든 동아리 목록은 시스템 마스터만
      // 새 동아리: 같은 묶음 쓰기에서 private/info 의 마스터가 나 자신이어야 한다
      allow create: if signedIn() && validSlug(slug) && validPublic(request.resource.data)
        && request.resource.data.createdAt == request.time
        && getAfter(infoPath(slug)).data.masterUid == request.auth.uid
        && slug in getAfter(/databases/$(database)/documents/masters/$(request.auth.uid)).data.slugs;   // 한 사람 10개까지 (masters 규칙)
      allow update: if (isMaster(slug) || (isSystem() && request.resource.data.get('connector', '') == resource.data.get('connector', '')))
        && validPublic(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // ---------- 연결기 마스터 키: 동아리 마스터만 (시스템 마스터도 못 읽음) ----------
      match /secret/{doc} {
        allow read, delete: if doc == 'key' && isMaster(slug);
        allow create, update: if doc == 'key' && isMaster(slug)
          && request.resource.data.keys().hasOnly(['masterKey', 'pendingKey', 'keyUid'])
          && (!('keyUid' in request.resource.data) || request.resource.data.keyUid == request.auth.uid)
          && request.resource.data.masterKey is string
          && request.resource.data.masterKey.size() >= 20 && request.resource.data.masterKey.size() <= 100
          && (!('pendingKey' in request.resource.data) || (request.resource.data.pendingKey is string
              && request.resource.data.pendingKey.size() >= 20 && request.resource.data.pendingKey.size() <= 100));
      }

      // ---------- 마스터 · 연결 정보 · 사용 현황 ----------
      match /support/{id} {
        allow read: if isMaster(slug) || isSystem();
        allow create: if request.resource.data.keys().hasOnly(['from', 'text', 'at', 'uid'])
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000
          && request.resource.data.at == request.time && request.resource.data.uid == request.auth.uid
          && ((request.resource.data.from == 'master' && isMaster(slug)) || (request.resource.data.from == 'system' && isSystem()));
        allow update, delete: if false;
      }
      match /private/{doc} {
        allow read: if isMaster(slug) || isSystem();
        allow create: if doc == 'info' && signedIn() && validInfo(request.resource.data)
          && request.resource.data.masterUid == request.auth.uid
          && !exists(/databases/$(database)/documents/clubs/$(slug))
          && existsAfter(/databases/$(database)/documents/clubs/$(slug));
        // 마스터: 마스터 ID는 그대로 두고 나머지만 수정
        allow update: if doc == 'info' && validInfo(request.resource.data) && (
          (isMaster(slug) && request.resource.data.masterUid == resource.data.masterUid)
          // 넘겨받기: 같은 묶음에서 제출한 코드가 넘기기 코드와 같고, 만료 전이며, 마스터 ID만 나로 바뀜
          || (signedIn()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['masterUid'])
              && request.resource.data.masterUid == request.auth.uid
              && exists(/databases/$(database)/documents/clubs/$(slug)/handover/current)
              && get(/databases/$(database)/documents/clubs/$(slug)/handover/current).data.expiresAt > request.time
              && getAfter(/databases/$(database)/documents/clubs/$(slug)/claims/$(request.auth.uid)).data.code
                 == get(/databases/$(database)/documents/clubs/$(slug)/handover/current).data.code
              && !existsAfter(/databases/$(database)/documents/clubs/$(slug)/handover/current)
              && get(/databases/$(database)/documents/clubs/$(slug)/handover/current).data.get('by', '') == resource.data.masterUid)   // 만든 사람이 지금 마스터일 때만   // 코드는 한 번만 (같은 묶음에서 지움)
          // 복구: 시스템 마스터는 마스터를 다른 사람으로만 바꿀 수 있다 (선생님 요청 시 · 자기 자신은 안 됨 → 연결기 키를 못 읽음)
          || (isSystem() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['masterUid'])
              && request.resource.data.masterUid != request.auth.uid
              && !existsAfter(/databases/$(database)/documents/clubs/$(slug)/handover/current)));
        allow delete: if false;
      }

      // ---------- 마스터 넘기기 ----------
      match /handover/{doc} {
        allow read: if isMaster(slug);   // 시스템 마스터도 못 읽음 (코드로 스스로 마스터가 되지 못하게)
        allow create, update: if doc == 'current' && isMaster(slug)
          && request.resource.data.keys().hasOnly(['code', 'expiresAt', 'by']) && request.resource.data.get('by', '') == request.auth.uid
          && request.resource.data.code is string && request.resource.data.code.size() >= 20
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt < request.time + duration.value(25, 'h');
        // 넘겨받는 사람은 같은 묶음에서 마스터가 되면서 코드를 지움
        allow delete: if isMaster(slug) || isSystem() || (signedIn() && getAfter(infoPath(slug)).data.masterUid == request.auth.uid);
      }
      match /claims/{uid} {
        allow read: if false;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['code']) && request.resource.data.code is string && request.resource.data.code.size() <= 64
          && exists(/databases/$(database)/documents/clubs/$(slug)/handover/current);
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- 내 동아리 목록 ----------
    match /masters/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow delete: if false;   // 지워서 10개 제한을 다시 쓰지 못하게
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['slugs']) && request.resource.data.slugs is list
        && request.resource.data.slugs.size() <= 30
        && (resource == null || request.resource.data.slugs.hasAll(resource.data.slugs));   // 늘리기만
    }

    // ---------- 시스템 마스터 ----------
    match /system/config {
      allow read: if signedIn() && request.auth.uid in resource.data.admins;
      allow write: if false;   // 콘솔에서만
    }
    // 시스템 마스터: 모든 동아리의 문의를 한꺼번에 (collectionGroup)
    match /{path=**}/support/{id} {
      allow read: if isSystem();
    }
    // 시스템 마스터의 동아리 목록 조회 (공개 정보 + private 는 위 규칙으로)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
